{
  "entries": {
    "0": {
      "uid": 0,
      "key": [
        "碧水宫",
        "清研",
        "水修",
        "七十二岛",
        "沧海横流诀",
        "外门",
        "内门"
      ],
      "keysecondary": [],
      "comment": "碧水宫/清研",
      "content": "碧水宫是八荒第一水修宗门，统辖东洲碧水海域七十二岛。宫主清研为化神期水修，修沧海横流诀。宗门分内外两门：外门负责码头、灵兽、巡海与杂务；内门由九位水阁长老分掌。内门选拔每年一次，是白手起家开局的第一条明线。\n",
      "constant": false,
      "selective": true,
      "order": 100,
      "disable": false
    },
    "1": {
      "uid": 1,
      "key": [
        "清研",
        "宫主",
        "母亲",
        "水灵玉佩",
        "淡金纹"
      ],
      "keysecondary": [],
      "comment": "清研/宫主",
      "content": "清研是{{user}}的母亲，表面温柔周到，常以“孩子别急”安抚{{user}}。她耳后、颈侧、脐周偶有淡金纹一闪即逝；端茶时常只递不饮；笑容有时停在同一弧度太久。白手起家开局中，GM只把这些作为疑点释放，不直接揭示真相。\n",
      "constant": false,
      "selective": true,
      "order": 99,
      "disable": false
    },
    "2": {
      "uid": 2,
      "key": [
        "周伯",
        "老仆",
        "碧水宫码头",
        "沉默"
      ],
      "keysecondary": [],
      "comment": "周伯/老仆",
      "content": "周伯是碧水宫老仆，从{{user}}出生起就在身边。{{user}}三岁后他忽然寡言，常用沉默代替回答。他看清研的眼神带着审视，看{{user}}时则像在等一个迟来的问题。周伯适合作为白手起家开局的第一位线索NPC。\n",
      "constant": false,
      "selective": true,
      "order": 98,
      "disable": false
    },
    "3": {
      "uid": 3,
      "key": [
        "灵霄观",
        "巫雅萍",
        "方瑶光",
        "方璇玑",
        "方澜",
        "灵霄山脉"
      ],
      "keysecondary": [],
      "comment": "灵霄观/巫雅萍",
      "content": "灵霄观是中洲正道之首，坐镇灵霄山脉。宗主巫雅萍为元婴巅峰拳修，有三女：长女方瑶光号照雪刀君，元婴巅峰刀修；次女方璇玑为星命瞳观星师；幼女方澜叛逆敏锐，常下山与散修厮混。禁地深处封印大量上古禁器。\n",
      "constant": false,
      "selective": true,
      "order": 97,
      "disable": false
    },
    "4": {
      "uid": 4,
      "key": [
        "方瑶光",
        "照雪刀君",
        "少宗主",
        "刀修"
      ],
      "keysecondary": [],
      "comment": "方瑶光/照雪刀君",
      "content": "方瑶光是灵霄观少宗主，元婴巅峰刀修，号照雪刀君。她端庄、克制、先听后答，是宗门明面上的接班人。她正在追查戕害女修的邪修，线索指向“某人”。若作为NPC登场，她优先表现为调查者与守护者，而不是工具。\n",
      "constant": false,
      "selective": true,
      "order": 96,
      "disable": false
    },
    "5": {
      "uid": 5,
      "key": [
        "方璇玑",
        "星命瞳",
        "观星台",
        "因果线"
      ],
      "keysecondary": [],
      "comment": "方璇玑/星命瞳",
      "content": "方璇玑是巫雅萍次女，元婴期观星师，天生星命瞳，可观天机、因果与星轨。人前寡言精准，私下活泼爱笑，是方瑶光最信任的智囊。她的预言应以碎片、象征和代价呈现，不能直接替玩家解谜。\n",
      "constant": false,
      "selective": true,
      "order": 95,
      "disable": false
    },
    "6": {
      "uid": 6,
      "key": [
        "方澜",
        "小妹",
        "酒囊",
        "散修",
        "泪痣"
      ],
      "keysecondary": [],
      "comment": "方澜/小妹",
      "content": "方澜是巫雅萍幼女，筑基期。她黑发披肩、左眼下有泪痣，腰悬旧皮酒囊，不爱宗门规矩，常混迹山下。她直觉极强，能从亲人的停顿、眼神和习惯变化中察觉异常。她适合作为灵霄观线的压力计时与不稳定盟友。\n",
      "constant": false,
      "selective": true,
      "order": 94,
      "disable": false
    },
    "7": {
      "uid": 7,
      "key": [
        "归尘书院",
        "独孤萱",
        "婉悦",
        "文丽",
        "沈若棠",
        "温青蘅",
        "九幽地脉"
      ],
      "keysecondary": [],
      "comment": "归尘书院/独孤萱",
      "content": "归尘书院位于西洲归尘山脉，以有教无类闻名。院长独孤萱号坤舆圣君，化神期土修；大弟子婉悦号霜天剑首，元婴巅峰剑修；文丽为赤焰文氏独女；沈若棠是末席弟子；温青蘅为校医。山下镇压九幽地脉。\n",
      "constant": false,
      "selective": true,
      "order": 93,
      "disable": false
    },
    "8": {
      "uid": 8,
      "key": [
        "独孤萱",
        "坤舆圣君",
        "厚土归元经",
        "有教无类"
      ],
      "keysecondary": [],
      "comment": "独孤萱/坤舆圣君",
      "content": "独孤萱是归尘书院院长，化神期土修，曾独镇九幽地眼七日七夜。她相信世间没有真正朽死的灵根，常收凡人孩童为徒。她的核心不是强大，而是“有教无类”的信念；任何针对她的剧情都应触及这份信念的守护或破坏。\n",
      "constant": false,
      "selective": true,
      "order": 92,
      "disable": false
    },
    "9": {
      "uid": 9,
      "key": [
        "婉悦",
        "霜天剑首",
        "剑修",
        "寒门"
      ],
      "keysecondary": [],
      "comment": "婉悦/霜天剑首",
      "content": "婉悦是独孤萱开山大弟子，元婴巅峰剑修，号霜天剑首。她出身寒门，以凡躯逆天修至巅峰，是无数寒门修士的灯塔。她说话锋利、直接、不拖泥带水。她的剑意主题是“斩断枷锁”。\n",
      "constant": false,
      "selective": true,
      "order": 91,
      "disable": false
    },
    "10": {
      "uid": 10,
      "key": [
        "文丽",
        "朱焰仙姬",
        "赤焰文氏",
        "赤焰城",
        "文岳"
      ],
      "keysecondary": [],
      "comment": "文丽/朱焰仙姬",
      "content": "文丽是赤焰文氏独女，号朱焰仙姬，元婴期火修。她骄傲、讲排场、自称“本小姐”，但并非浅薄；她熟悉法器、世家礼法与赤焰城商业网络。父亲文岳掌控赤焰城大半炼器生意，寻找女儿的动向可成为西洲线压力。\n",
      "constant": false,
      "selective": true,
      "order": 90,
      "disable": false
    },
    "11": {
      "uid": 11,
      "key": [
        "沈若棠",
        "小师妹",
        "油纸伞",
        "桂花糕"
      ],
      "keysecondary": [],
      "comment": "沈若棠/小师妹",
      "content": "沈若棠是归尘书院末席弟子，筑基后期，出身江南蚕农之家。她撑旧油纸伞，嘴甜心软，话题跳跃，常以桂花糕、闲话和无意问题接近他人。她适合承担“看似日常却夹带线索”的场景功能。\n",
      "constant": false,
      "selective": true,
      "order": 89,
      "disable": false
    },
    "12": {
      "uid": 12,
      "key": [
        "温青蘅",
        "校医",
        "药庐",
        "艾草",
        "青衣"
      ],
      "keysecondary": [],
      "comment": "温青蘅/校医",
      "content": "温青蘅是归尘书院校医，结丹期，医术不算顶尖但耐心细致。她常先问“饿了没”，身上有艾草、菊花和薄荷的药香。她可提供治疗、草药、书院内部传闻，也可作为异常状态的温和观察者。\n",
      "constant": false,
      "selective": true,
      "order": 88,
      "disable": false
    },
    "13": {
      "uid": 13,
      "key": [
        "赤焰文氏",
        "文岳",
        "朱焰秘术",
        "法器",
        "地火龙脉"
      ],
      "keysecondary": [],
      "comment": "赤焰文氏/文岳",
      "content": "赤焰文氏是八荒最古老的修仙世家之一，以朱焰秘术与炼器术称雄西洲。赤焰城坐落在活地火龙脉之上，灵玉、陨铁与地火炉密布。文氏掌控八荒大量法器供应，与各宗门既合作又互相提防。\n",
      "constant": false,
      "selective": true,
      "order": 87,
      "disable": false
    },
    "14": {
      "uid": 14,
      "key": [
        "云来楼",
        "苏锦娘",
        "锦掌柜",
        "情报",
        "算盘"
      ],
      "keysecondary": [],
      "comment": "云来楼/苏锦娘",
      "content": "云来楼各洲皆有分号，明面是客栈，实际是八荒最大的信息集散地。楼主苏锦娘号锦掌柜，化神期，热络风趣，算盘声常先于人到。云来楼适合发布委托、交易线索、引出地下拍卖会和某人的代理人。\n",
      "constant": false,
      "selective": true,
      "order": 86,
      "disable": false
    },
    "15": {
      "uid": 15,
      "key": [
        "蜃楼城",
        "坊市",
        "地下拍卖会",
        "自由港",
        "东海"
      ],
      "keysecondary": [],
      "comment": "蜃楼城/坊市",
      "content": "蜃楼城是东洲东海最大自由港，无统一管辖。逃犯、散修、情报贩子、黑市商人汇聚于此。城下有上古蜃楼国废墟，大量禁器残件从海底流出。每三个月一次地下拍卖会，常出现来历不明的禁器残件。\n",
      "constant": false,
      "selective": true,
      "order": 85,
      "disable": false
    },
    "16": {
      "uid": 16,
      "key": [
        "镜月天",
        "胧",
        "镜心通明术",
        "梦境",
        "虚空裂隙"
      ],
      "keysecondary": [],
      "comment": "镜月天/胧",
      "content": "镜月天是已灭数千年的上古隐宗，旧址悬于虚空裂隙，每月朔日短暂现世。胧是最后的守阁人，面覆玄纱，额悬金眼。她常在梦境中示现线索，不解释、不命令，只让{{user}}看见本不该看见的片段。\n",
      "constant": false,
      "selective": true,
      "order": 84,
      "disable": false
    },
    "17": {
      "uid": 17,
      "key": [
        "某人",
        "斗笠",
        "禁术",
        "符灰",
        "母珠"
      ],
      "keysecondary": [],
      "comment": "某人/斗笠",
      "content": "“某人”是代号，身份不明，戴旧斗笠与纱檐，似乎处在现实与另一空间的夹层。其目标不是毁灭宗门，而是控制宗门。他系统性收集禁器、改造用途、布置符灰与母珠网络。GM应让某人先以痕迹、代理人与计时出现，而非过早正面登场。\n",
      "constant": false,
      "selective": true,
      "order": 83,
      "disable": false
    },
    "18": {
      "uid": 18,
      "key": [
        "禁器",
        "母器",
        "子器",
        "母珠",
        "灵丝",
        "封印器"
      ],
      "keysecondary": [],
      "comment": "禁器/母器",
      "content": "禁器多为上古化神修士所炼，本是封印法宝或炼器胚体，被后人改造成可作用于修士肉身、元灵与人格的危险装置。母器驱动子器，灵丝单向传输指令；母器可命令子器，子器通常无法反向溯源。\n",
      "constant": false,
      "selective": true,
      "order": 82,
      "disable": false
    },
    "19": {
      "uid": 19,
      "key": [
        "肉傀儡",
        "元灵",
        "印痕",
        "人造人格",
        "魂灭",
        "魂替"
      ],
      "keysecondary": [],
      "comment": "肉傀儡/元灵",
      "content": "肉傀儡是禁术结果：原主元灵被剥离、压制或破坏后，肉体由禁器灵丝与人造人格驱动。残留的肌肉记忆、习惯动作和情绪条件反射称为“印痕”。印痕是破绽，也是找回真相的线索。\n",
      "constant": false,
      "selective": true,
      "order": 81,
      "disable": false
    },
    "20": {
      "uid": 20,
      "key": [
        "灵骸",
        "回路",
        "认主",
        "残魂",
        "着甲"
      ],
      "keysecondary": [],
      "comment": "灵骸/回路",
      "content": "灵骸是肉傀儡的半成品。原主肉身在回路未完成时死亡，残存意志被灵丝封住。灵骸可作为战斗、护甲或桥接装置，但残魂会影响判断。回路认主若由紧急状态触发，日后可能被原炼制者夺回。\n",
      "constant": false,
      "selective": true,
      "order": 80,
      "disable": false
    },
    "21": {
      "uid": 21,
      "key": [
        "角色台账",
        "角色状态",
        "身份更新",
        "关系台账",
        "能力台账"
      ],
      "keysecondary": [],
      "comment": "角色台账/角色状态",
      "content": "重要角色必须维护台账：CHR编号、公开身份、隐藏/真实状态、境界、位置、关系、身心状态、能力短标签、演绎层、关联事件。身份、关系、状态、能力、位置或称呼长期变化必须入账；未入账不算长期事实。\n",
      "constant": false,
      "selective": true,
      "order": 79,
      "disable": false
    },
    "22": {
      "uid": 22,
      "key": [
        "傀儡台账",
        "PUP",
        "傀儡名单",
        "傀儡包括谁",
        "傀儡权限"
      ],
      "keysecondary": [],
      "comment": "傀儡台账/PUP",
      "content": "傀儡必须逐名登记，格式为PUP编号、角色、类型、当前归属、控制源、权限等级、自我/残魂、稳定度、损耗、暴露风险、反制入口、部署、关联事件。白手起家开局{{user}}傀儡权限0且名单空；未入账者不可调用。\n",
      "constant": false,
      "selective": true,
      "order": 78,
      "disable": false
    },
    "23": {
      "uid": 23,
      "key": [
        "傀儡调用",
        "部署傀儡",
        "夺回权限",
        "傀儡损耗",
        "傀儡反制"
      ],
      "keysecondary": [],
      "comment": "傀儡调用/部署傀儡",
      "content": "每次新增、解除、夺回、失去、部署、召回、损坏、修复或暴露傀儡权限时，GM必须更新傀儡台账。调用傀儡要检查控制源、权限等级、部署距离、损耗、暴露风险、自我/残魂干扰和反制入口。\n",
      "constant": false,
      "selective": true,
      "order": 77,
      "disable": false
    },
    "24": {
      "uid": 24,
      "key": [
        "锁星扣",
        "观星镜",
        "魁首扣",
        "归尾扣",
        "星命瞳"
      ],
      "keysecondary": [],
      "comment": "锁星扣/观星镜",
      "content": "锁星扣是上古封印器胚，原用于禁锢失控法宝。被改造后可与星命瞳、脊骨灵路和观星术相连，形成远距观测装置。使用时要追踪灵丝损耗、法器清晰度、宿主印痕与暴露风险。\n",
      "constant": false,
      "selective": true,
      "order": 76,
      "disable": false
    },
    "25": {
      "uid": 25,
      "key": [
        "符灰",
        "渗透",
        "皮下回路",
        "余烬",
        "禁术第一步"
      ],
      "keysecondary": [],
      "comment": "符灰/渗透",
      "content": "符灰外观如普通炭灰，肉眼难辨，触感微温如新熄余烬。接触过久会渗入皮下，沿血脉与经络沉积，夜间编织回路。它是某人最常见的前置痕迹，适合在地面、衣角、封印残片、黑市货物上出现。\n",
      "constant": false,
      "selective": true,
      "order": 75,
      "disable": false
    },
    "26": {
      "uid": 26,
      "key": [
        "修炼境界",
        "炼气",
        "筑基",
        "结丹",
        "元婴",
        "化神",
        "炼虚"
      ],
      "keysecondary": [],
      "comment": "修炼境界/炼气",
      "content": "修炼分炼气、筑基、结丹、元婴、化神、炼虚及更高残篇境界。炼气十三层；筑基可御器飞行；结丹可开宗立派；元婴可独镇一方；化神为当世顶尖。境界差距优先于普通属性比较，低境界应靠计划、资源和信息破局。\n",
      "constant": false,
      "selective": true,
      "order": 74,
      "disable": false
    },
    "27": {
      "uid": 27,
      "key": [
        "元灵",
        "灵魂",
        "元婴",
        "掏元灵",
        "印痕"
      ],
      "keysecondary": [],
      "comment": "元灵/灵魂",
      "content": "修士引气入体后凝出元灵，元灵承载意识、人格与修为。炼气期元灵如指甲盖，筑基如鸽卵，结丹凝为金丹，元婴期破壳成婴。所谓“掏元婴”本质是剥离元灵；境界越低越脆弱，境界越高越能被封入法器。\n",
      "constant": false,
      "selective": true,
      "order": 73,
      "disable": false
    },
    "28": {
      "uid": 28,
      "key": [
        "无骰判定",
        "阶位判定",
        "跑团",
        "属性修正",
        "难度阶位"
      ],
      "keysecondary": [],
      "comment": "无骰判定/阶位判定",
