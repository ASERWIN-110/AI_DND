{
  "name": "ai-dnd-agent-framework",
  "version": "0.1.0",
  "description": "A minimal AI agent chat framework for text RPGs with character cards, prompt assembly, RAG, and OpenAI-compatible APIs.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-build-assets.mjs",
    "bundle": "node scripts/package-release.mjs",
    "bundle:full": "node scripts/package-release.mjs --include-node-modules",
    "chc:merge-txt": "node scripts/merge-chc-setting-txt.mjs",
    "chc:merge-txt:dry": "node scripts/merge-chc-setting-txt.mjs --dry-run",
    "demo": "node --import tsx examples/demo.mjs",
    "dev": "node scripts/quick-start.mjs --source --no-open",
    "package:release": "node scripts/package-release.mjs",
    "package:release:full": "node scripts/package-release.mjs --include-node-modules",
    "quickstart": "node scripts/quick-start.mjs",
    "quick-start": "node scripts/quick-start.mjs",
    "start": "node scripts/quick-start.mjs --no-open",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fast-xml-parser": "^5.8.0",
    "js-tiktoken": "^1.0.21",
    "lru-cache": "^11.5.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
